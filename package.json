		"@tanstack/react-query": "^5.105.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.1",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.14",
		"isbot": "^5.1.36",
		"jose": "^6.2.14",
		"lucide-react": "^1.66.0",
		"postal-mime": "^4.2.0",
		"radix-ui": "^1.8.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.0",
		"shadcn": "^4.23.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.66.0",
