{
	"name": "cfw-mailbox",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"typecheck": "wrangler types --strict-vars=false && react-router typegen && tsc -b",
		"deploy": "pnpm run build && wrangler deploy",
		"preview": "pnpm run build && vite preview",
		"cf-typegen": "wrangler types --strict-vars=false",
		"postinstall": "wrangler types --strict-vars=false",
		"test": "vitest run"
	},
	"dependencies": {
