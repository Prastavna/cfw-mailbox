		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"vitest": "^4.1.12",
		"wrangler": "^4.156.0"
	},
	"packageManager": "pnpm@12.16.1",
	"cloudflare": {
		"label": "cfw-mailbox",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Email Routing",
			"Email Service"
		],
		"bindings": {
			"ACCESS_TEAM_DOMAIN": {
				"description": "Your Cloudflare Access team domain, e.g. https://myteam.cloudflareaccess.com. Shown when you enable Access on the Worker."
			},
			"ACCESS_AUD": {
				"description": "The Access application's Audience (AUD) tag. Shown when you enable Access on the Worker."
			},
			"ADMIN_EMAILS": {
				"description": "Comma-separated emails that can manage domains, mailboxes and members."
			}
		}
	}
