/**
 * cfw-mailbox — self-hosted, Gmail-style webmail on Cloudflare Workers.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cfw-mailbox",
	"compatibility_date": "2026-10-23",
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,

	"vars": {
		// "access" (production) or "dev" (local only). `pnpm dev` switches to "dev" automatically.
		"AUTH_MODE": "access"
	},
	// Set as secrets (`wrangler secret put`, or the prompts of the Deploy button; see .dev.vars.example):
	//   ACCESS_TEAM_DOMAIN  your Access team domain, e.g. https://myteam.cloudflareaccess.com
	//   ACCESS_AUD          the Application Audience (AUD) tag of the Access application
	//   ADMIN_EMAILS        comma-separated emails allowed to manage domains, mailboxes and members
	//   ENCRYPTION_KEY      any long random string; encrypts users' AI provider keys

	// Per-location request budgets (approximate; see docs/deploying.md "Limits").
	"ratelimits": [
		// Every signed-in API request, per user.
		{ "name": "API_LIMITER", "namespace_id": "41001", "simple": { "limit": 600, "period": 60 } },
		// Sends, attachment uploads and exports, per user.
		{ "name": "HEAVY_LIMITER", "namespace_id": "41002", "simple": { "limit": 30, "period": 60 } },
		// AI Assistant requests (summaries, drafts, rewrites, chat), per user.
		{ "name": "AI_LIMITER", "namespace_id": "41003", "simple": { "limit": 20, "period": 60 } }
	],

	"durable_objects": {
		"bindings": [
			// Singleton: domains, mailboxes and who may access them.
			{ "name": "REGISTRY", "class_name": "RegistryDO" },
			// One instance per mailbox: messages, threads, labels.
			{ "name": "MAILBOX", "class_name": "MailboxDO" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistryDO", "MailboxDO"] }],

	// Raw .eml files, large HTML bodies and attachments.
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cfw-mailbox" }],

	// Outbound mail via Cloudflare Email Service. Local dev simulates sends (no real mail);
	// add "remote": true to send real mail from `pnpm dev`.
	"send_email": [{ "name": "EMAIL" }],

	// Workers AI, one of the AI Assistant's providers. Billed to this Cloudflare account, unlike
	// the other providers, where each user brings their own API key. Always remote, even in dev.
	"ai": { "binding": "AI" }
}
